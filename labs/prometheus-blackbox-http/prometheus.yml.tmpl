global:
  scrape_interval: 2s
  scrape_timeout: 1s

scrape_configs:
  - job_name: readiness_probe
    metrics_path: /probe
    params:
      module: [http_readiness]
    static_configs:
      - targets: ["${target}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "${exporter}"
