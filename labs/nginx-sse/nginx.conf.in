worker_processes 1;
error_log stderr warn;
pid nginx.pid;

events {}

http {
    access_log off;

    server {
        listen 127.0.0.1:@PROXY_PORT@;

        location = /orders/42/events {
            proxy_pass http://127.0.0.1:@UPSTREAM_PORT@;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
        }
    }
}
